# Copy to .env for local dev. docker-compose injects DB/Redis URLs itself.
APP_NAME=Lamoon HR
ENVIRONMENT=dev

# `app` (not `lamoon`) — the bootstrap superuser BYPASSes RLS. See db/init/01-app-role.sql.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/lamoon
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-every-real-deploy-min-32-bytes-long-0123456789
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14
OAUTH_STATE_TTL_MIN=10

# OAuth (Google/Microsoft "Login with..."). Leave empty to disable a provider
# — its /auth/oauth/{provider}/start returns 503 instead of erroring at runtime.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Where a successful/failed OAuth login sends the browser back to (apps/web's
# callback page). Success carries tokens in the URL fragment (never sent to
# any server); failure carries ?error=<code>.
OAUTH_FRONTEND_REDIRECT=http://localhost:3000/oauth/callback

GEMINI_API_KEY=
AI_DEFAULT_MODEL=gemini-2.5-flash

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@lamoon.local

API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
