# Copy to .env for local dev. docker-compose injects DB/Redis URLs itself.
APP_NAME=Lamoon HR
ENVIRONMENT=dev

DATABASE_URL=postgresql+psycopg://lamoon:lamoon@localhost:5432/lamoon
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-every-real-deploy
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14

GEMINI_API_KEY=
AI_DEFAULT_MODEL=gemini-2.5-flash
